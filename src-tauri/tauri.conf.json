{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PoxiEQ",
  "version": "0.1.0",
  "identifier": "com.poxi.poxieq",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PoxiEQ",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": false,
        "backgroundColor": "#0a0e17",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Poxi",
    "copyright": "Poxi",
    "category": "Utility",
    "shortDescription": "Ecualizador para la salida de audio de Windows",
    "longDescription": "PoxiEQ ecualiza todo el sonido de Windows (juegos, música, llamadas) con una curva que mueves con el ratón, presets y correcciones de AutoEq para tus cascos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../CHANGELOG.md": "CHANGELOG.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCRjdDNjg5QUFBRDBBNDcKUldSSENxMnFpY2IzQzRVSjhiSDB6dzIwU1dWY3dMbXpDMUFBMGVaN1Q2bzhpVXNjem4zVWFxVW4K",
      "endpoints": [
        "https://github.com/PoxiiTV/PoxiEQ/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
